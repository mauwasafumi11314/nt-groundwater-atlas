# Copy to .env and adjust. .env is gitignored.
POSTGRES_USER=ntgw
POSTGRES_PASSWORD=ntgw
POSTGRES_DB=ntgw
POSTGRES_PORT=5432
NTGW_DATABASE_URL=postgresql+psycopg2://ntgw:ntgw@127.0.0.1:5432/ntgw

# PROJ must not silently fetch grids from the network: a grid that appears at
# run time is a grid that can vanish, and the project's guarantee is that a
# missing grid fails loudly. Install proj-data instead.
PROJ_NETWORK=OFF
